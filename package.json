    "@types/string-similarity": "^4.0.2",
    "@types/ws": "^8.5.14",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
